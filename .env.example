# Toggle deployment mode: true = multi-tenant SaaS, false = single-tenant standalone
VITE_MULTI_TENANT=false

# Backend endpoint.
#
# Leave this as /api in development: the Vite dev server proxies it through to
# the backend, which sidesteps the fact that the API sends no CORS headers.
VITE_API_BASE_URL=/api

# Where the dev proxy forwards /api. Point at localhost when running the
# backend yourself.
VITE_API_PROXY_TARGET=https://e5energy-production.up.railway.app

# Unused for now: /ws on the backend is the helmets' own channel, not a
# dashboard feed. The dashboard polls instead — see src/config/features.ts.
VITE_WS_URL=

# Standalone branding — used only when VITE_MULTI_TENANT=false.
VITE_APP_NAME=Helmet Dashboard
VITE_APP_LOGO_URL=
VITE_BRAND_PRIMARY=#0f766e
VITE_BRAND_SECONDARY=#1e293b

# Google Maps. The browser key is public by design — restrict it by HTTP
# referrer in the Google Cloud console. Advanced markers require a Map ID.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Set true to develop the UI against a simulated fleet
VITE_USE_MOCKS=false