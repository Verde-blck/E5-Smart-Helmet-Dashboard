# Toggle deployment mode: true = multi-tenant SaaS, false = single-tenant standalone
VITE_MULTI_TENANT=false

# Backend endpoints (Spring Boot service, once available)
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080/ws

# Standalone branding — used only when VITE_MULTI_TENANT=false.
# In SaaS mode these come from the tenant record instead.
VITE_APP_NAME=Helmet Dashboard
VITE_APP_LOGO_URL=
VITE_BRAND_PRIMARY=#0f766e
VITE_BRAND_SECONDARY=#1e293b

# Set true to develop the UI against a simulated fleet before the backend exists
VITE_USE_MOCKS=true
